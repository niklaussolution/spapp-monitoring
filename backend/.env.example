# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spapp_monitoring
DB_USER=postgres
DB_PASSWORD=changeme

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Firebase (Firestore for admin accounts + FCM for push commands) —
# no env vars needed here; place the service account key file at
# backend/firebase-service-account.json (gitignored). See README.md
# "Data Storage Architecture" for where to get it.

# CORS
DASHBOARD_ORIGIN=http://localhost:5173
